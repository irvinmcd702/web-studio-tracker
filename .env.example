# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://tracker:tracker@localhost:5440/studio_tracker?schema=public"
# openssl rand -base64 32 — the server refuses to start in production with this
# left as the example value.
AUTH_SECRET="change-me"
# The address people actually open. Invite links and notifications are built
# from it, so localhost in production means links nobody can follow.
APP_URL="http://localhost:3000"

# --- Files ------------------------------------------------------------------
# Attachments are written here. In Docker this is a volume; on one host a plain
# directory is fine. Running several instances needs shared storage instead.
UPLOAD_DIR="./uploads"

# --- Mail (optional, but invites and password resets need it) ---------------
# Either one URL…
# SMTP_URL="smtp://user:password@mail.example.com:587"
# …or the parts:
# SMTP_HOST="mail.example.com"
# SMTP_PORT="587"
# SMTP_USER="tracker@example.com"
# SMTP_PASSWORD=""
# MAIL_FROM="Studio Tracker <tracker@example.com>"
#
# Without any of these the tracker still works: invite and reset links are
# shown on screen for a manager to pass on, and the self-service "forgot
# password" page says plainly that it cannot help.

# --- Outreach mail (only if you send campaigns) ------------------------------
# A SEPARATE server, separate credentials and a separate sending subdomain from
# the block above. That separation is the whole point: a spam complaint about
# cold mail must not stop somebody resetting their password. Outreach never
# falls back to SMTP_* — with these unset, campaigns simply do not send.
#
# The sending subdomain also needs its own SPF, DKIM and DMARC records, and —
# once inbound exists — routing to your provider's inbound endpoint.
# OUTREACH_SMTP_URL="smtp://user:password@mail.example.com:587"
# …or the parts:
# OUTREACH_SMTP_HOST="mail.example.com"
# OUTREACH_SMTP_PORT="587"
# OUTREACH_SMTP_USER="hello@hi.example.com"
# OUTREACH_SMTP_PASSWORD=""
# OUTREACH_MAIL_FROM="Northwind <hello@hi.example.com>"

# --- Drafting with a model (optional) ----------------------------------------
# Without a key the drafting buttons do not exist. With one, the studio still
# has to switch the feature on, and each project still has to allow its own
# material to be sent — both default to off.
# OPENROUTER_API_KEY="sk-or-…"
#
# Any OpenAI-compatible endpoint works: a proxy inside your network, or a model
# on your own hardware. For a studio whose client material must not leave the
# building, this is what makes the feature usable at all.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# --- The daily digest (optional) ---------------------------------------------
# Shared secret for POST /api/cron/daily, which sends the digest. Without it
# the endpoint answers 404 and nothing is scheduled; the "Needs attention" panel
# on the dashboard works either way, because it is computed on the spot.
# CRON_SECRET="openssl rand -base64 24"
#
# One secret, two schedules: the nightly digest and retention sweep, and the
# outreach run every five minutes. That five minutes is the resolution of every
# send window and every gap between two messages.
# DIGEST_AT="0 8 * * *"
# OUTREACH_AT="*/5 * * * *"

# --- Backups (compose only) ---------------------------------------------------
# When the nightly backup runs, and how many days are kept. It also runs once
# on start, so a broken backup is found the day it is set up.
# BACKUP_AT="0 3 * * *"
# BACKUP_KEEP_DAYS="14"

# --- Compose only -----------------------------------------------------------
# POSTGRES_PASSWORD="a real password"
# PORT="3000"
# When to run the digest, in crontab syntax. Server time.
# DIGEST_AT="0 8 * * *"

# --- First administrator (only on an empty database) --------------------------
# The server creates this account on boot and prints a one-time link to the log.
# Does nothing once any account exists. Remove both once you are in.
# BOOTSTRAP_ADMIN_EMAIL="you@studio.com"
# BOOTSTRAP_ADMIN_NAME="Your Name"

# --- Demo data (only on a database with no projects) --------------------------
# Fills the tracker with a studio worth of plausible work for a walkthrough:
# four workflows from simple to full, four clients, six people, five projects.
# Prints one generated password for every demo account to the log.
# SEED_DEMO_DATA="true"
# DEMO_PASSWORD="pick one yourself, or let it generate"
